PORT=3000
CONTAINER_NAME=FleetCore_api

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=FleetCore_db
DATABASE_db=FleetCore_db
DATABASE_PASSWORD=change_me

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Comma-separated list of keys accepted by the x-api-key header on external-integration
# endpoints (e.g. GET /vehicle/external/:plate).
API_KEYS=demo-key-partner-1,demo-key-partner-2
